{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:4000"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ModelMapping": {
    "Rules": [
      { "Prefix": "claude-haiku", "Target": "qwen/qwen3.5-9b", "Backend": "lmstudio" },
      { "Prefix": "claude",       "Target": "deepseek/deepseek-v4-pro" }
    ]
  },
  "Backends": {
    "openrouter": {
      "BaseUrl": "https://openrouter.ai/api",
      "TranslateAnthropicToOpenAI": true,
      "ReasoningFormat": "OpenRouter"
    },
    "lmstudio": {
      "BaseUrl": "http://127.0.0.1:1234"
    },
    "openai": {
      "BaseUrl": "https://api.openai.com",
      "OpenAIProtocol": "Responses"
    }
  },
  "Upstream": {
    "BaseUrl": "https://openrouter.ai/api"
  },
  "ModelDiscovery": {
    "Enabled": false,
    "Models": []
  },
  "Cors": {
    "AllowedOrigins": [ "https://pivot.claude.ai" ]
  },
  "Admin": {
    "ApiKey": null,
    "RuntimeConfigPath": "mappings-runtime.json"
  },
  "Classifier": {
    "Target": "deepseek/deepseek-v4-flash",
    "Backend": "openrouter"
  },
  "ComplianceLog": {
    "Enabled": false,
    "Path": "/var/log/ai-gateway/compliance.log"
  }
}

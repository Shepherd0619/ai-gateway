{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:4000"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ModelMapping": {
    "Rules": [
      { "Prefix": "claude-deepseek", "Target": "deepseek-v4-pro", "Backend": "deepseek" },
      { "Prefix": "claude-openrouter", "Target": "deepseek/deepseek-v4-pro", "Backend": "openrouter" },
      { "Prefix": "claude-haiku", "Target": "qwen/qwen3.5-9b", "Backend": "lmstudio" },
      { "Prefix": "claude", "Target": "deepseek/deepseek-v4-pro", "Backend": "openrouter" },
      { "Prefix": "openai/", "Target": "", "Backend": "openrouter" },
      { "Prefix": "google/", "Target": "", "Backend": "openrouter" },
      { "Prefix": "anthropic/", "Target": "", "Backend": "openrouter" }
    ]
  },
  "Backends": {
    "openrouter": {
      "BaseUrl": "https://openrouter.ai/api",
      "TranslateAnthropicToOpenAI": true,
      "ReasoningFormat": "OpenRouter"
    },
    "deepseek": {
      "BaseUrl": "https://api.deepseek.com/anthropic",
      "TranslateAnthropicToOpenAI": false
    },
    "openai": {
      "BaseUrl": "https://api.openai.com",
      "TranslateAnthropicToOpenAI": false
    },
    "lmstudio": {
      "BaseUrl": "http://127.0.0.1:1234"
    }
  },
  "Upstream": {
    "BaseUrl": "https://openrouter.ai/api"
  },
  "Cors": {
    "AllowedOrigins": [ "https://pivot.claude.ai", "http://localhost:4173" ]
  },
  "Admin": {
    "ApiKey": "hello-world",
    "RuntimeConfigPath": "obj/local-testing/mappings-runtime.json"
  },
  "Classifier": {
    "Target": "",
    "Backend": "openrouter"
  },
  "ComplianceLog": {
    "Enabled": false,
    "Path": "/var/log/ai-gateway/compliance.log"
  }
}

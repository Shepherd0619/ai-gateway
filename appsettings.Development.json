{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:4000"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ModelMapping": {
    "Rules": [
      { "Prefix": "openai/",      "Target": "" },
      { "Prefix": "claude-opus",  "Target": "openai/gpt-5.6-terra" },
      { "Prefix": "claude-sonnet","Target": "openai/gpt-5.6-luna" },
      { "Prefix": "claude-haiku", "Target": "qwen/qwen3.5-9b", "Backend": "lmstudio" },
      { "Prefix": "claude",       "Target": "openai/gpt-5.6-luna" },
      { "Prefix": "google/",      "Target": "" },
      { "Prefix": "anthropic/",   "Target": "" }
    ]
  },
  "Backends": {
    "openrouter": {
      "BaseUrl": "https://openrouter.ai/api"
    },
    "lmstudio": {
      "BaseUrl": "http://127.0.0.1:1234"
    }
  },
  "Upstream": {
    "BaseUrl": "https://openrouter.ai/api"
  },
  "Cors": {
    "AllowedOrigins": [ "https://pivot.claude.ai", "http://localhost:4173" ]
  },
  "Admin": {
    "ApiKey": "hello-world",
    "RuntimeConfigPath": "mappings-runtime.json"
  },
  "Classifier": {
    "Target": "openai/gpt-5.6-luna",
    "Backend": "openrouter"
  },
  "WebSearch": {
    "TargetModel": "deepseek/deepseek-v4-flash-0731"
  },
  "ComplianceLog": {
    "Enabled": false,
    "Path": "/var/log/ai-gateway/compliance.log"
  }
}
